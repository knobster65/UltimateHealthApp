SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:////var/www/UltimateHealthApp/backend/health.db
NIGHTSCOUT_URL=
NIGHTSCOUT_API_TOKEN=
ALLOWED_ORIGINS=https://karcass.com
WEBHOOK_SECRET=auto-generated-by-deploy-script

# AI Provider Configuration (supports: abacusai, openai, anthropic)
AI_PROVIDER=abacusai
AI_API_KEY=your-api-key-here
AI_MODEL=o4-mini  # Use model name for your provider (e.g., gpt-4.1, claude-sonnet-4-6)
# AI_BASE_URL=https://routellm.abacus.ai/v1  # Optional custom base URL

# For AbacusAI (default):
#   AI_PROVIDER=abacusai
#   AI_MODEL=o4-mini (or qwen3-23b, gpt-4o, etc.)

# For OpenAI:
#   AI_PROVIDER=openai
#   AI_MODEL=gpt-4.1 or gpt-4o

# For Anthropic:
#   AI_PROVIDER=anthropic
#   AI_MODEL=claude-sonnet-4-6 or claude-opus-4-7
