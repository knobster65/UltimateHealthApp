[Unit]
Description=UltimateHealthApp FastAPI Backend
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/UltimateHealthApp/backend
Environment="PATH=/var/www/UltimateHealthApp/backend/venv/bin"
ExecStart=/var/www/UltimateHealthApp/backend/venv/bin/gunicorn app.main:app -w 4 -k uvicorn.workers.UvicornWorker -b 127.0.0.1:8000 --access-logfile /var/log/ultimatehealth-access.log --error-logfile /var/log/ultimatehealth-error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
